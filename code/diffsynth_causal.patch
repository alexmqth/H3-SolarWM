+def _build_causal_block_masks(
+    v0,
+    fr,
+    latent_t,
+    chunk_frames,
+    window_chunks,
+    cu_seqlens,
+    seq_len,
+    device,
+    n_real=None,
+    ann_rows=None,
+):
+    """Build a chunk-causal FlexAttention mask for H3's packed sequence.
+
+    H3 packs ``[text | first-frame condition | audio | video | pad]`` into
+    one sequence.  This mask leaves the non-video prefix as static context,
+    lets a video query read only its current chunk and a bounded history of
+    earlier chunks, and hides video rows from prefix queries.  ``ann_rows``
+    optionally adds the existing directed per-latent action binding in the
+    same mask, because FlexAttention accepts one block mask per segment.
+
+    This is a mask-only prototype.  It enforces the causal boundary while
+    retaining H3's full-sequence QKV projection; it does not claim the raw-KV
+    reuse or SGF/DMD distillation implemented by SolarWM.
+    """
+    from torch.nn.attention.flex_attention import create_block_mask
+
+    if int(fr) <= 0 or int(latent_t) <= 0:
+        raise ValueError("causal video layout must have positive frame rows and latent frames")
+    if int(chunk_frames) <= 0 or int(window_chunks) <= 0:
+        raise ValueError("chunk_frames and window_chunks must be positive")
+    # Fixed buffers are reused so torch.compile does not bake a sample-specific
+    # closure into the FlexAttention kernel (see _build_action_block_masks).
+    masks = {}
+    bounds = cu_seqlens.tolist()
+    video_end = int(v0) + int(fr) * int(latent_t)
+    for start, stop in zip(bounds[:-1], bounds[1:]):
+        length = int(stop - start)
+        if length <= 0:
+            continue
+        local_real = length if n_real is None else max(0, min(int(n_real) - int(start), length))
+        key = (str(device), int(start), length)
+        buf = _CAUSAL_MASK_BUFFERS.get(key)
+        if buf is None:
+            buf = {
+                "chunk": torch.full((length,), -1, dtype=torch.int32, device=device),
+                "ann": torch.full((length,), -1, dtype=torch.int32, device=device),
+                "frm": torch.full((length,), -1, dtype=torch.int32, device=device),
+                "lim": torch.zeros((), dtype=torch.int32, device=device),
+            }
+            _CAUSAL_MASK_BUFFERS[key] = buf
+        chunk, ann, frm, lim = buf["chunk"], buf["ann"], buf["frm"], buf["lim"]
+        chunk.fill_(-1)
+        ann.fill_(-1)
+        frm.fill_(-1)
+        lim.fill_(local_real)
+
+        vlo, vhi = int(v0) - int(start), video_end - int(start)
+        if vhi > 0 and vlo < length:
+            lo, hi = max(vlo, 0), min(vhi, length)
+            rows = torch.arange(lo, hi, device=device)
+            absolute = rows + int(start)
+            frame = (absolute - int(v0)) // int(fr)
+            chunk[lo:hi] = (frame // int(chunk_frames)).to(torch.int32)
+        any_video = bool(vhi > 0 and vlo < length)
+
+        any_ann = False
+        if ann_rows is not None:
+            for k in range(int(ann_rows.shape[0])):
+                lo, hi = int(ann_rows[k, 0]) - int(start), int(ann_rows[k, 1]) - int(start)
+                lo, hi = max(lo, 0), min(hi, length)
+                if hi > lo:
+                    ann[lo:hi] = k
+                    any_ann = True
+            if any_video:
+                lo, hi = max(vlo, 0), min(vhi, length)
+                rows = torch.arange(lo, hi, device=device)
+                frm[lo:hi] = ((rows + int(start) - int(v0)) // int(fr)).to(torch.int32)
+        has_pad = local_real < length
+        if not any_video and not any_ann and not has_pad:
+            # Prefix-only segment has no causal restriction and no padding.
+            continue
+
+        def mask_mod(b, h, q, kv, chunk=chunk, ann=ann, frm=frm, lim=lim,
+                     window=int(window_chunks)):
+            q_chunk, k_chunk = chunk[q], chunk[kv]
+            q_video, k_video = q_chunk >= 0, k_chunk >= 0
+            static_to_static = (~q_video) & (~k_video)
+            video_to_static = q_video & (~k_video)
+            video_to_video = q_video & k_video & (k_chunk <= q_chunk)
+            video_to_video = video_to_video & (k_chunk >= q_chunk - window + 1)
+            allowed = static_to_static | video_to_static | video_to_video
+
+            # Preserve the directed action-text binding when this sample also
+            # has per-latent action rows.  These are the same edge rules as the
+            # standalone H3 action mask, combined here with causal visibility.
+            aq, akv, fq, fkv = ann[q], ann[kv], frm[q], frm[kv]
+            has_ann = (aq >= 0) | (akv >= 0)
+            same_ann = (aq >= 0) & (akv >= 0) & (aq == akv)
+            v_reads_own = (fq >= 0) & (akv >= 0) & (fq == akv)
+            leak_out = (akv >= 0) & ~same_ann & ~v_reads_own
+            leak_in = (aq >= 0) & (fkv >= 0) & (aq != fkv)
+            allowed = allowed & (~has_ann | ~(leak_out | leak_in))
+            real = (q < lim) & (kv < lim)
+            return (q == kv) | (real & allowed)
+
+        masks[start] = create_block_mask(mask_mod, None, None, length, length, device=device)
+    return masks
+
